{
  "version": "3.1.0",
  "privacy": "No raw email, phone, message, or free-text fields. PostHog runs with mask_all_inputs: true, so raw form values are never stored; funnel events count starts/submits/successes only.",
  "stages": [
    {"id": "attention", "events": ["$pageview", "content_landing"]},
    {"id": "engagement", "events": ["cta_clicked"]},
    {"id": "intent", "events": ["lead_form_view", "lead_form_start"]},
    {"id": "lead", "events": ["lead_form_submit", "lead_form_success"]},
    {"id": "qualified", "events": ["qualified_lead"], "capture": "missing", "note": "defined but not yet captured — labeled missing, never zero"},
    {"id": "conversation", "events": ["booked_call"], "capture": "missing", "note": "defined but not yet captured — labeled missing, never zero"},
    {"id": "revenue", "events": ["sale"], "capture": "missing", "note": "defined but not yet captured — labeled missing, never zero"}
  ],
  "website_lead_gen": {
    "goal_events_per_stage": {
      "attention": ["$pageview", "content_landing"],
      "engagement": ["cta_clicked"],
      "intent": ["lead_form_view", "lead_form_start"],
      "lead": ["lead_form_submit", "lead_form_success"]
    },
    "required_properties": ["locale", "page_path", "landing_path", "source", "medium", "campaign", "content_id", "form_type"],
    "objectives": {"qualified_visits_per_day": 200, "leads_per_day": 10, "lead_conversion_rate": 0.05},
    "formulas": {
      "qualified_visits_per_day": "daily count of content_landing events on qualified source/medium/campaign traffic",
      "leads_per_day": "daily count of lead_form_success",
      "lead_conversion_rate": "leads_per_day / qualified_visits_per_day"
    }
  },
  "campaign_join_keys": ["campaign_id", "batch_id", "item_id", "content_id", "creative_signature"],
  "objectives": {"qualified_visits_per_day": 200, "leads_per_day": 10, "lead_conversion_rate": 0.05},
  "formulas": {
    "ctr": "content_landings / platform_views",
    "service_intent_rate": "service_cta_clicks / content_landings",
    "lead_conversion_rate": "leads / content_landings"
  },
  "experiment_contract": {
    "test_types": ["single-variable", "a/b", "factorial", "funnel"],
    "scopes": ["cross-channel-creative", "website-cro"],
    "variable_count": {"minimum": 1, "maximum": 3, "sparse_evidence_default": 1},
    "required": ["control_and_variant_cells", "assignment", "primary_metric", "guardrails", "minimum_evidence_per_cell", "analysis_method"],
    "multi_change_rule": "Independent effects for every variable or one supported interaction effect.",
    "website_mutation": "Separate approval required."
  },
  "required_properties": ["locale", "page_path", "landing_path", "source", "medium", "campaign", "campaign_id", "batch_id", "item_id", "content_id", "platform", "creative_signature", "batch_number", "batch_item", "hook_id", "narrative_type"]
}