{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:spielos:graph:1",
  "title": "SpielOS executable DAG v1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "version",
    "input_schema",
    "output_schema",
    "nodes",
    "edges",
    "entrypoints",
    "outputs",
    "required_capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "input_schema": {
      "$ref": "#/$defs/contract"
    },
    "output_schema": {
      "$ref": "#/$defs/contract"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "version",
          "group",
          "availability",
          "status",
          "input_schema",
          "output_schema",
          "dependencies",
          "capabilities",
          "bindings",
          "implementation",
          "execution",
          "evaluation_requirements"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
          },
          "type": {
            "enum": [
              "agent",
              "skill",
              "tool",
              "workflow",
              "runtime",
              "memory",
              "evaluation",
              "artifact",
              "input",
              "output",
              "connection",
              "improvement"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "type": "string",
            "minLength": 1
          },
          "availability": {
            "enum": [
              "implemented",
              "compatibility",
              "held",
              "planned"
            ]
          },
          "status": {
            "const": "pending"
          },
          "input_schema": {
            "$ref": "#/$defs/contract"
          },
          "output_schema": {
            "$ref": "#/$defs/contract"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "bindings": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/binding"
            }
          },
          "implementation": {
            "$ref": "#/$defs/implementation"
          },
          "execution": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "inspect",
                  "workflow",
                  "unavailable"
                ]
              },
              "release": {
                "type": "string",
                "minLength": 1
              },
              "retry_safe": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "evaluation_requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "question",
                "implementation"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "question": {
                  "type": "string",
                  "minLength": 1
                },
                "implementation": {
                  "$ref": "#/$defs/implementation"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target",
          "relationship"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "relationship": {
            "enum": [
              "requires",
              "data",
              "context",
              "evaluates",
              "records"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "entrypoints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "outputs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/binding"
      }
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "implementation": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "object",
            "array",
            "string",
            "integer",
            "number",
            "boolean",
            "null"
          ]
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/contract"
          }
        },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "type": "boolean"
        },
        "items": {
          "$ref": "#/$defs/contract"
        },
        "enum": {
          "type": "array",
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "input"
          ],
          "properties": {
            "input": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "node",
            "path"
          ],
          "properties": {
            "node": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
