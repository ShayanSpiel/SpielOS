          ],
          "requires": [],
          "skill_ids": [
            "videography"
          ],
          "connection_ids": []
        },
        {
          "id": "record_render",
          "kind": "agent",
          "agent_id": "videography-operator",
          "produces": [
            "showcase_video"
          ],
          "requires": [
            "demo_scenario"
          ],
          "skill_ids": [
            "videography"
          ],
          "connection_ids": []
        }
      ]
    }
  ],
  "template": null,
  "agents": [
    {
      "id": "videography-operator",
