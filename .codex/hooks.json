{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/spielos-context.py",
            "timeout": 10,
            "statusMessage": "Restoring SpielOS company context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/spielos-context.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/spielos-attention.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
